# ========================================================
# PROVANA Backend Environment Configuration (.env.example)
# ========================================================

# Server Configuration
SERVER_PORT=8081
SERVER_CONTEXT_PATH=/

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=provana_db
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_POOL_SIZE=10
DB_MIN_IDLE=5

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Configuration (Phase 1)
JWT_SECRET=provana-super-secret-production-grade-hmac-sha256-key-min-256-bits!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Razorpay Payment Gateway (Phase 6)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder_secret

# AI Service / Vector DB (Phase 11)
AI_API_KEY=placeholder_ai_key
VECTOR_DB_URL=http://localhost:8000
